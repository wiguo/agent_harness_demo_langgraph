# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. LangChain/LangGraph trace to LangSmith natively off these vars;
# when unset, no tracing happens and the app runs identically.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-harness-langgraph
